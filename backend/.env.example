# Copy this to backend/.env (which is git-ignored) and fill in what you need.
# The always-on service sources backend/.env at startup; nothing here is secret.

# Turns on AI-personalised quests. Get a free key: https://aistudio.google.com/apikey
# Leave blank to use the handcrafted quest pools (the app works fully without it).
ARISE_LLM_API_KEY=your-google-ai-studio-key

# Optional. Defaults to gemini-flash-latest (tracks the current flash model, so a
# retired version can't break it). Older ids like gemini-2.0/2.5-flash may be
# unavailable to new keys.
# ARISE_LLM_MODEL=gemini-flash-latest

# Optional. Turns on "capture a video" (Inspire tab): paste a TikTok, Reel or
# Short and it fetches the spoken transcript, then the LLM distills it into
# takeaways + pull-quotes that resurface on your Status. Free key (100/mo, no
# card): https://supadata.ai — leave blank and the feature simply hides.
ARISE_SUPADATA_API_KEY=your-supadata-key

# Optional. Require a bearer token on every request (also set it in the app under
# Settings → System link). Left blank, auth is off (Tailscale is the boundary).
# ARISE_API_TOKEN=
