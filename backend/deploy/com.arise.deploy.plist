<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template — do not load directly. Run `bash backend/deploy/install.sh`, which
  substitutes __BACKEND_DIR__ for your machine and loads it.

  Checks origin/main every 2 minutes: fast-forwards, rebuilds the web app only if
  the frontend moved, and restarts com.arise.backend only if something needs it.

  Two minutes rather than something lazier because with no new commit this is one
  `git fetch` against an unchanged ref — a few KB and a few milliseconds — so the
  only thing a longer interval buys is waiting. launchd won't start a second copy
  while one is still running, and the script takes its own lock as well, so a
  build that outlasts the interval just means the next tick is skipped.

  This is what stops a pushed change sitting invisible on the phone: dist/ is
  gitignored, so a pull alone never updates the UI.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arise.deploy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__BACKEND_DIR__/../scripts/deploy.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BACKEND_DIR__/..</string>

    <!-- Every 2 minutes, and once when it loads (login / reboot). -->
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__BACKEND_DIR__/logs/deploy.log</string>
    <key>StandardErrorPath</key>
    <string>__BACKEND_DIR__/logs/deploy.log</string>
</dict>
</plist>
