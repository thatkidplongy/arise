<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template — do not load directly. Run `bash backend/deploy/install.sh`, which
  substitutes __BACKEND_DIR__ / __PYTHON__ for your machine and loads it.
  Always-on API: starts at login, restarts on crash, relaunches after reboot.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arise.backend</string>

    <!-- Sources backend/.env (git-ignored, if present) for secrets/config, then
         runs uvicorn. No secret ever lives in this tracked template. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>set -a; [ -f "__BACKEND_DIR__/.env" ] &amp;&amp; . "__BACKEND_DIR__/.env"; set +a; exec "__PYTHON__" -m uvicorn app.main:app --host 0.0.0.0 --port 8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BACKEND_DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__BACKEND_DIR__/logs/backend.log</string>
    <key>StandardErrorPath</key>
    <string>__BACKEND_DIR__/logs/backend.log</string>

    <!-- Config/secrets live in backend/.env (git-ignored), sourced at startup by
         the wrapper above — see backend/.env.example:
         • ARISE_LLM_API_KEY  free Google AI Studio key → AI-personalised quests
         • ARISE_API_TOKEN    require a token (also set it in the app)
         • ARISE_LLM_MODEL    optional; default gemini-flash-latest -->
</dict>
</plist>
