{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-touched.sh\"",
            "timeout": 30,
            "statusMessage": "Checking standards\u2026"
          }
        ]
      }
    ]
  }
}
